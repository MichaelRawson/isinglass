#!/bin/sh

usage() {
  echo "usage: $0 [--trace] [--optimise] [--implicits=KINDS] [--complete] FRONTEND BACKEND < proof.p (e.g. $0 vampire lambdapi)" >&2
  exit 2
}

# --trace prints the name and tactic of each step as its reconstruction starts;
# --optimise inlines and simplifies the proof before it is emitted;
# --implicits=eq,letp gives Agda further type arguments that it would otherwise solve (see src/agda.pl);
# --complete makes the Agda back ends fail, naming what the holes would stand for, instead of
# printing a proof with holes.
options=
while [ $# -gt 2 ]; do
  case $1 in
    --trace) options=${options:+$options,}trace ;;
    --optimise) options=${options:+$options,}optimise ;;
    --complete) options=${options:+$options,}complete ;;
    --implicits=*)
      kinds=${1#--implicits=}
      case $kinds in ''|,*|*,|*,,*) usage ;; esac
      for kind in $(echo "$kinds" | tr , ' '); do
        case $kind in eq|letp) ;; *) usage ;; esac
      done
      options=${options:+$options,}"implicits([$kinds])" ;;
    *) usage ;;
  esac
  shift
done
if [ $# -ne 2 ]; then usage; fi

# src/main.pl relative to this script (following symlinks), so that ising
# can be called from any directory
here=$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")
exec swipl -g "main($1, $2, [$options])" "$here/src/main.pl"
