#!/bin/sh

usage() {
  echo "usage: $0 [--trace] [--optimise] FRONTEND BACKEND < proof.p (e.g. $0 vampire lambdapi)" >&2
  exit 2
}

# --trace prints the name and tactic of each step as its reconstruction starts;
# --optimise inlines and simplifies the proof before it is emitted.
options=
while [ $# -gt 2 ]; do
  case $1 in
    --trace) options=${options:+$options,}trace ;;
    --optimise) options=${options:+$options,}optimise ;;
    *) usage ;;
  esac
  shift
done
if [ $# -ne 2 ]; then usage; fi

# src/main.pl relative to this script (following symlinks), so that ising
# can be called from any directory
here=$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")
exec swipl -g "main($1, $2, [$options])" "$here/src/main.pl"
